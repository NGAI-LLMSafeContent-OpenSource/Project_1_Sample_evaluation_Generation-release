{
  "scope": "CPU existing tests, approved one-triplet parsing and Streamlit live HTTP; no live LLM or browser interaction",
  "requirements": "requirements.txt",
  "command_timeout": 600,
  "commands": [
    {
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "argv": [
        "{python}",
        "-m",
        "benchmark.cli",
        "--help"
      ]
    },
    {
      "argv": [
        "{python}",
        "tools/check_triplet.py"
      ]
    }
  ],
  "servers": [
    {
      "argv": [
        "{python}",
        "-m",
        "streamlit",
        "run",
        "scripts/viewer/app.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "{port}",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "ready": "/_stcore/health",
      "checks": [
        {
          "path": "/_stcore/health",
          "text_contains": "ok"
        },
        {
          "path": "/",
          "text_contains": "<html"
        }
      ]
    }
  ]
}
